void main() {
  int a = 17;
  int b = 5;

  print("Soma: ${a + b}");
  print("Subtração: ${a - b}");
  print("Multiplicação: ${a * b}");
  print("Divisão: ${a / b}");
  print("Divisão inteira: ${a ~/ b}");
  print("Resto: ${a % b}");
}




void main() {
  double nota1 = 7.5;
  double nota2 = 8.0;
  double nota3 = 6.2;

  double media = (nota1 + nota2 + nota3) / 3;

  print("Média: ${media.toStringAsFixed(1)}");
}


void main() {
  int total = 200;

  int horas = total ~/ 60;
  int minutos = total % 60;

  print("$horas h e $minutos min");
}






 
